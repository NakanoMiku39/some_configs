font=FiraCode Nerd Font 11
background-color=#282828e6
text-color=#ebdbb2ff
border-color=#83a598ff
border-size=2
border-radius=12
progress-color=over #83a598ff

width=380
height=140
outer-margin=12
margin=6
padding=12,14
anchor=top-right
layer=overlay

icons=1
max-icon-size=48
icon-border-radius=8
markup=1
actions=1
history=1
max-history=20
max-visible=4
sort=-time
default-timeout=5000
ignore-timeout=0
format=<b>%s</b>\n%b

on-button-left=invoke-default-action
on-button-middle=dismiss-all
on-button-right=dismiss

[urgency=low]
border-color=#504945ff
default-timeout=3000

[category=device]
border-color=#8ec07cff
default-timeout=1800

[category=system]
border-color=#83a598ff
default-timeout=5000

[category=system.battery]
border-color=#fabd2fff
default-timeout=8000

[urgency=critical]
background-color=#3c3836f2
border-color=#fb4934ff
text-color=#fbf1c7ff
default-timeout=0

[grouped]
format=(%g) <b>%s</b>\n%b

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
