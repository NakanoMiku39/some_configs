font=FiraCode Nerd Font 11
background-color=#0c121ee6
text-color=#dce3eeff
border-color=#61afefff
border-size=2
border-radius=12
progress-color=over #61afefff

width=380
height=140
outer-margin=12
margin=6
padding=12,14
anchor=top-right
layer=overlay

icons=1
max-icon-size=48
icon-border-radius=8
markup=1
actions=1
history=1
max-history=20
max-visible=4
sort=-time
default-timeout=5000
ignore-timeout=0
format=<b>%s</b>\n%b

on-button-left=invoke-default-action
on-button-middle=dismiss-all
on-button-right=dismiss

[urgency=low]
border-color=#3f4f68ff
default-timeout=3000

[category=device]
border-color=#72d6d3ff
default-timeout=1800

[category=system]
border-color=#61afefff
default-timeout=5000

[category=system.battery]
border-color=#e5c07bff
default-timeout=8000

[urgency=critical]
background-color=#201217f2
border-color=#e06c75ff
text-color=#ffffffff
default-timeout=0

[grouped]
format=(%g) <b>%s</b>\n%b

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
