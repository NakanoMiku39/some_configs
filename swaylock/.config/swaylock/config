# Background
color=282828
image=~/Pictures/wallpaper.png
scaling=fill

# Indicator
indicator-radius=78
indicator-thickness=5
indicator-caps-lock

# Ring
ring-color=504945
ring-clear-color=8ec07c
ring-caps-lock-color=fabd2f
ring-ver-color=83a598
ring-wrong-color=fb4934

# Center
inside-color=282828cc
inside-clear-color=282828cc
inside-caps-lock-color=282828cc
inside-ver-color=282828cc
inside-wrong-color=3c3836e6

# Line and separators
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000

# Text
text-color=ebdbb2
text-clear-color=8ec07c
text-caps-lock-color=fabd2f
text-ver-color=83a598
text-wrong-color=fb4934

# Key feedback
bs-hl-color=fb4934
key-hl-color=b8bb26
caps-lock-bs-hl-color=fb4934
caps-lock-key-hl-color=fabd2f

# Layout
layout-text-color=928374
layout-bg-color=00000000
layout-border-color=00000000

# Typography and behavior
font=FiraCode Nerd Font
font-size=20
line-uses-ring
disable-caps-lock-text
show-failed-attempts
