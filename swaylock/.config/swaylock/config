# Background
color=0c121e
image=~/Pictures/wallpaper.png
scaling=fill

# Indicator
indicator-radius=78
indicator-thickness=5
indicator-caps-lock

# Ring
ring-color=3f4f68
ring-clear-color=72d6d3
ring-caps-lock-color=e5c07b
ring-ver-color=61afef
ring-wrong-color=e06c75

# Center
inside-color=0c121ecc
inside-clear-color=0c121ecc
inside-caps-lock-color=0c121ecc
inside-ver-color=0c121ecc
inside-wrong-color=201217e6

# Line and separators
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000

# Text
text-color=dce3ee
text-clear-color=72d6d3
text-caps-lock-color=e5c07b
text-ver-color=61afef
text-wrong-color=e06c75

# Key feedback
bs-hl-color=e06c75
key-hl-color=98c379
caps-lock-bs-hl-color=e06c75
caps-lock-key-hl-color=e5c07b

# Layout
layout-text-color=93a4b8
layout-bg-color=00000000
layout-border-color=00000000

# Typography and behavior
font=FiraCode Nerd Font
font-size=20
line-uses-ring
disable-caps-lock-text
show-failed-attempts
