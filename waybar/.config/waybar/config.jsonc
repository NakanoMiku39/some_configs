{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 4,
  "modules-left": [
    "custom/logout",
    "tray"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/notifications",
    "network",
    "bluetooth",
    "pulseaudio",
    "battery"
    // "backlight",
    // "custom/temperature",
    // "memory",
    // "cpu"
  ],
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "on-click": "activate",
    "persistent-workspaces": {
    "*":[1,2,3,4,5,6,7,8,9]
    },
    "format-icons": {
      "1": "󰣇",
      "2": "󰈹",
      "3": "󰇮",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "󰖳",
      "default": ""
    }
  },
  "custom/logout": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "电源菜单",
    "menu": "on-click",
    "menu-file": "/home/nakanomiku/.config/waybar/power-menu.xml",
    "menu-actions": {
      "lock": "swaylock",
      "logout": "niri msg action quit",
      "suspend": "systemctl suspend",
      "reboot": "systemctl reboot",
      "poweroff": "systemctl poweroff"
    }
  },
  "custom/notifications": {
    "exec": "/home/nakanomiku/.config/scripts/mako-status",
    "interval": 2,
    "format": "{}",
    "on-click": "makoctl restore",
    "on-click-middle": "makoctl dismiss --all",
    "on-click-right": "makoctl mode -t do-not-disturb",
    "tooltip": true,
    "tooltip-format": "mako 通知\n左键恢复上一条，右键勿扰，中键清空"
  },
  "custom/reboot": {
    "format": "<span color='#fabd2f'>  </span>",
    "on-click": "systemctl reboot",
    "tooltip": true,
    "tooltip-format": "重启"
  },
  "custom/power": {
    "format": "<span color='#fb4934'>  </span>",
    "on-click": "systemctl poweroff",
    "tooltip": true,
    "tooltip-format": "关机"
  },
  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 Wired",
    "tooltip-format": "上传 {bandwidthUpBytes}  下载 {bandwidthDownBytes}\n左键网络设置，右键新增 Wi-Fi",
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n上传 {bandwidthUpBytes}  下载 {bandwidthDownBytes}\n左键网络设置，右键新增 Wi-Fi",
    "tooltip-format-ethernet": "{ifname} wired\n上传 {bandwidthUpBytes}  下载 {bandwidthDownBytes}\n左键网络设置",
    "tooltip-format-disconnected": "网络未连接\n左键网络设置，右键新增 Wi-Fi",
    "format-linked": "󱘖 {ifname} no IP",
    "format-disconnected": "󰤭 Offline",
    "format-alt": "󰤨 {signalStrength}%",
    "on-click": "nm-connection-editor",
    "on-click-right": "nm-connection-editor --type=802-11-wireless --create",
    "interval": 1
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "interval": 1,
    "format-icons": ["󰂎", "󰁼", "󰁿", "󰂁", "󰁹"],
    "tooltip": true
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click-right": "pavucontrol -t 3",
    "on-click": "pactl -- set-sink-mute 0 toggle",
    "tooltip": true,
    "tooltip-format": "当前系统声音: {volume}%"
  },
  "custom/temperature": {
    "exec": "sensors | awk '/^Package id 0:/ {print int($4)}'",
    "format": "<span color='#fe8019'> </span>{}°C ",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "当前 CPU 温度: {}°C"
  },
  "memory": {
    "format": "<span color='#d3869b'>  </span>{used:0.1f}G/{total:0.1f}G ",
    "tooltip": true,
    "tooltip-format": "当前内存占比: {used:0.2f}G/{total:0.2f}G"
  },
  "cpu": {
    "format": "<span color='#fe8019'>  </span>{usage}% ",
    "tooltip": true
  },
  "clock": {
    "interval": 1,
    "timezone": "Asia/Shanghai",
    "format": "{:L%Y-%m-%d %A %H:%M:%S}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>\n右键切换日历模式，滚轮切换月份",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#83a598'><b>{}</b></span>",
        "days": "<span color='#ebdbb2'><b>{}</b></span>",
        "weeks": "<span color='#928374'>W{}</span>",
        "weekdays": "<span color='#fabd2f'><b>{}</b></span>",
        "today": "<span color='#b8bb26'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "<span color='#fabd2f'>{icon}</span>{percent}% ",
    "tooltip": true,
    "tooltip-format": "当前屏幕亮度: {percent}%",
    "format-icons": [
      "<span color='#665c54'> 󰃞 </span>",  // 暗 - 深灰
      "<span color='#928374'> 󰃝 </span>",  // 中 - 灰
      "<span color='#d79921'> 󰃟 </span>",  // 亮 - 黄色
      "<span color='#fabd2f'> 󰃠 </span>"   // 最亮 - 金色
    ]
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "on-click": "blueman-manager",
    "on-click-right": "blueman-adapters",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n左键设备管理，右键适配器设置",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}\n左键设备管理，右键适配器设置",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  }
}
